# frozen_string_literal: true
# Scheduled asgard tasks, using the platform's own scheduler: launchd on
# macOS (lib/launchd_schedule.rb), systemd user timers on Linux
# (lib/systemd_schedule.rb). Both run a calendar job that was missed while
# the machine slept as soon as it wakes, and both implement the same backend
# API (see lib/schedule_declaration.rb), so nothing below is platform-specific.
#
# Import this file, then declare schedules in the repo's own .loki:
#
#   import_up "dev/schedule.loki"
#
#   class Tasks
#     schedule :daily_summary, at: "17:30", on: :weekdays
#     schedule :weekly_report, at: "16:00", on: :friday
#     schedule :sync,          every: 1.hour                # or plain seconds: 3600
#     schedule :backup,        at: %w[02:00 14:00]          # on: defaults to :daily
#
#     # The task's own options/flags go in options:, split the way a shell
#     # would (quotes respected).
#     schedule :report, options: "--format md -v",      at: "08:00", on: :weekdays
#     schedule :report, options: "--period week",       at: "16:00", on: :friday
#     schedule :notify, options: "--msg 'backup done'", every: 86_400, as: "notify_daily"
#   end
#
# on: takes :daily, :weekdays, :weekends, a day (:friday), or an Array of days.
# options: may also be an Array of words (["--title", "Week End"]).
# env: { "KEY" => "value" } adds literal environment variables to the job.
# as: "name" names the entry. It defaults to the task name, or to a slug of
# the task plus its options (:report, options: "--format md -v" =>
# report-format-md-v), so one task can be scheduled with different flags.
#
# Each entry runs `asgard <task> [options]` from the directory holding .loki
# (so any subdirectory works), with the PATH that was current at install
# time. When the repo has a .envrc, the job runs under `direnv exec` so RR,
# API keys, etc. come from .envrc at run time rather than being copied into
# the job definition. `asgard schedule log NAME` shows the output.
#
# `schedule` is both the declaration helper above and a command with
# subcommands:
#
#   asgard schedule preview        # job files that install would write
#   asgard schedule install        # load declared entries; drop undeclared ones
#   asgard schedule list           # installed entries, state, last exit status
#   asgard schedule stop NAME      # stop one entry (stays stopped across reboots and installs)
#   asgard schedule start NAME     # start a stopped entry, or install just this one
#   asgard schedule trigger NAME   # run an installed entry now, under the scheduler
#   asgard schedule log NAME [-f]  # print the entry's log (-f keeps following it)
#   asgard schedule remove         # unload and delete all of this project's entries

require "shellwords"
require "active_support"
require "active_support/core_ext/integer/time" # every: 3.minutes, 2.hours, 1.day
require_relative "lib/schedule_declaration"

case RUBY_PLATFORM
when /darwin/ then require_relative "lib/launchd_schedule"
when /linux/  then require_relative "lib/systemd_schedule"
end

class Tasks
  @@schedules ||= {}

  # Declaration helper, called at class level in a .loki. Distinct from the
  # instance-level `schedule` command that `subcommand` defines below.
  def self.schedule(task, **settings)
    spec  = ScheduleDeclaration.normalize(task, **settings)
    taken = @@schedules[spec[:name]]
    raise ArgumentError, "schedule: #{spec[:name].inspect} is already declared; give one a distinct as: name" if taken && taken != spec

    @@schedules[spec[:name]] = spec
  end

  def self.schedules = @@schedules
end

# Subclasses Asgard::Base rather than Tasks so `asgard schedule help` lists
# only these subcommands, not every project task.
class ScheduleCommands < Asgard::Base
  namespace "schedule"

  desc "tree", "Print a tree of the schedule subcommands", hide: true
  def tree = super

  no_commands do
    # Backend failures (a launchctl/systemctl error) end the command with
    # their message instead of a stack trace.
    def invoke_command(...)
      super
    rescue ScheduleDeclaration::Error => e
      abort "schedule: #{e.message}"
    end

    def schedules = Tasks.schedules

    def schedule_root = (Asgard.find_task_file&.dirname || Pathname.pwd).to_s

    def schedule_project = File.basename(schedule_root)

    def scheduler
      @scheduler ||= case RUBY_PLATFORM
                     when /darwin/ then LaunchdSchedule
                     when /linux/  then SystemdSchedule
                     else abort "asgard schedule: #{RUBY_PLATFORM} is not supported (needs macOS launchd or Linux systemd)"
                     end.new(project: schedule_project, root: schedule_root)
    end

    def declared_schedules
      abort "No schedules declared. Add `schedule :task, at: \"HH:MM\"` inside class Tasks in #{schedule_root}/.loki." if schedules.empty?

      unknown = schedules.values.map { it[:task] }.uniq - Tasks.all_commands.keys
      abort "schedule: no such task(s): #{unknown.join(', ')}" unless unknown.empty?

      schedules.values
    end

    def schedule_direnv
      return unless File.exist?(File.join(schedule_root, ".envrc"))

      ScheduleDeclaration.which("direnv", ENV["PATH"]) or
        $stderr.puts "schedule: .envrc found but direnv is not on PATH; its variables will not be loaded"
    end

    def schedule_asgard = ScheduleDeclaration.which("asgard", ENV["PATH"]) || abort("schedule: asgard is not on PATH")

    def schedule_summary(spec) = "#{ScheduleDeclaration.command_line(spec[:task], spec[:args])} (#{ScheduleDeclaration.describe(**spec)})"

    def schedule_install(spec, asgard:, direnv:)
      state = scheduler.install(spec, asgard:, direnv:)
      note  = state == :stopped ? " [stopped; `asgard schedule start #{spec[:name]}` to resume]" : ""
      puts "installed #{spec[:name]}: #{schedule_summary(spec)}#{note}"
    end

    def schedule_uninstall(name)
      scheduler.uninstall(name)
      puts "removed #{name}"
    end

    def require_installed!(name)
      abort "#{name} is not installed (see `asgard schedule list`)." unless scheduler.installed_names.include?(name)
    end
  end

  desc "Show the job files install would write, without installing them"
  def preview
    asgard = ScheduleDeclaration.which("asgard", ENV["PATH"]) || "asgard"
    direnv = schedule_direnv
    declared_schedules.each do |spec|
      scheduler.files(spec, asgard:, direnv:).each do |path, content|
        puts "# #{path}: #{schedule_summary(spec)}"
        puts content
      end
    end
  end

  desc "Install this project's schedule declarations (removes undeclared ones)"
  def install
    specs  = declared_schedules
    asgard = schedule_asgard
    direnv = schedule_direnv

    (scheduler.installed_names - specs.map { it[:name] }).each { schedule_uninstall(it) }
    specs.each { schedule_install(it, asgard:, direnv:) }
    scheduler.notes.each { $stderr.puts it }
  end

  desc "Show this project's installed entries, their state, and last exit status"
  def list
    names = scheduler.installed_names
    return puts "No scheduled tasks installed for #{schedule_project} (#{scheduler.scheduler})." if names.empty?

    names.each do |name|
      status = scheduler.status(name)
      state  = case status[:state]
               when :active  then "active; last exit: #{status[:last_exit] || 'never run'}"
               when :stopped then "stopped"
               else "not loaded"
               end
      spec   = schedules[name]
      timing = spec ? schedule_summary(spec) : "no longer declared"
      puts "#{name}  #{timing}  [#{state}]  log: #{scheduler.log_path(name)}"
    end
  end

  desc "stop NAME", "Stop one scheduled entry; it stays stopped across reboots and installs until started"
  def stop(name)
    require_installed!(name)
    scheduler.stop(name)
    puts "stopped #{name}"
  end

  desc "start NAME", "Start a stopped entry, or install and start just this declared entry"
  def start(name)
    spec = schedules[name]
    abort "#{name} is neither declared nor installed (see `asgard schedule list`)." unless spec || scheduler.installed_names.include?(name)

    if spec
      declared_schedules # validates the task exists
      scheduler.install(spec, asgard: schedule_asgard, direnv: schedule_direnv) # refresh the job files
    else
      $stderr.puts "schedule: #{name} is no longer declared; starting its installed job as-is"
    end
    scheduler.start(name)
    puts "started #{name}"
  end

  desc "trigger NAME", "Run an installed entry now, under the scheduler's environment"
  def trigger(name)
    require_installed!(name)
    abort "#{name} is stopped; `asgard schedule start #{name}` first." if scheduler.status(name)[:state] == :stopped

    scheduler.trigger(name)
    puts "triggered #{name}; output goes to #{scheduler.log_path(name)}"
  end

  desc "log NAME", "Print the named entry's log file to STDOUT"
  method_option :follow, aliases: "-f", type: :boolean, desc: "Keep printing new output as it arrives (tail -f)"
  def log(name)
    abort "#{name} is neither declared nor installed (see `asgard schedule list`)." unless schedules.key?(name) || scheduler.installed_names.include?(name)

    path = scheduler.log_path(name)
    return $stderr.puts "#{name} has no log yet (#{path}); it is created on the first run." unless File.exist?(path)
    return sh("tail -n +1 -f #{path.shellescape}", silent: true, exec: true) if options[:follow]

    IO.copy_stream(path, $stdout)
  end

  desc "Remove all of this project's installed entries"
  def remove
    names = scheduler.installed_names
    return puts "No scheduled tasks installed for #{schedule_project}." if names.empty?

    names.each { schedule_uninstall(it) }
  end
end

class Tasks
  desc "schedule SUBCOMMAND", "Manage schedules declared with `schedule :task, ...` (launchd on macOS, systemd on Linux)"
  subcommand "schedule", ScheduleCommands
end
