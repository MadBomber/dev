# frozen_string_literal: true
require "fileutils"
# MadBomber-level gem lifecycle tasks. Universal across all projects.
# Import from a project-level loki (e.g. `import_up "dev/gem_tasks.loki"`).
#
# @@gem_name defaults to the gemspec's basename (falling back to the current
# directory's basename); a component/project may set it earlier if it differs.

# `build` depends on `quality`, from quality.loki. Unlike a relative import,
# __FILE__ keeps a symlinked dev/ path the way import_up recorded it, and the
# guard skips quality.loki already loaded under another path: one load.
import File.join(File.dirname(__FILE__), "quality.loki") unless Tasks.method_defined?(:bundled_gem?)

class Tasks
  @@gem_name ||= if (gemspec = Dir.glob("*.gemspec").first)
                   File.basename(gemspec, ".gemspec").freeze
                 else
                   File.basename(Dir.pwd).freeze
                 end

  # The only branch `release` runs on; a component/project may set it earlier
  # (e.g. @@release_branch = "master").
  @@release_branch ||= "main".freeze

  # The version `gem build` will use: the gemspec's own, so a computed VERSION
  # (e.g. `[0, 1, 0].join(".")`) still names the file right. Falls back to a
  # string literal in lib/<gem_name with - as />/version.rb, then in the first
  # version.rb that defines VERSION, then "?.?.?".
  helper(:gem_version) do
    gemspec_version(Dir.glob("*.gemspec").first) || version_rb_literal || "?.?.?"
  end

  # nil when there is no gemspec or it doesn't load (RubyGems warns why).
  helper(:gemspec_version) do |gemspec|
    version = gemspec && Gem::Specification.load(gemspec)&.version&.to_s
    version unless version.to_s.empty?
  rescue StandardError
    nil
  end

  helper(:version_rb_literal) do
    pattern = /VERSION\s*=\s*['"]([^'"]+)['"]/
    preferred = "lib/#{@@gem_name.tr('-', '/')}/version.rb"
    candidates = [preferred, *Dir.glob("lib/**/version.rb")].uniq.select { File.file?(it) }
    candidates.lazy.map { File.read(it)[pattern, 1] }.find { it && !it.empty? }
  rescue StandardError
    nil
  end

  desc "Open IRB console with gem loaded"
  def console
    if File.exist?("bin/console")
      sh "bin/console"
    else
      # Since Ruby 4.0 irb is a bundled gem, so Bundler won't run it unless it's in the bundle.
      if File.exist?("Gemfile.lock") && !File.read("Gemfile.lock").match?(/^\s+irb \(/)
        abort "irb is not in the bundle: add `gem \"irb\"` to the Gemfile's development group, or add a bin/console."
      end
      sh "bundle exec irb -Ilib -r #{@@gem_name.tr('-', '/')}"
    end
  end

  # The checked-out branch, or nil outside a git checkout.
  helper(:current_branch) do
    branch = `git rev-parse --abbrev-ref HEAD 2>/dev/null`.strip
    branch unless branch.empty?
  end

  # Why a release from +branch+ is refused, or nil when +allowed+ is checked out.
  helper(:release_branch_error) do |branch, allowed|
    next if branch == allowed

    "Releases are made from #{allowed} only; this is #{branch || 'not a git checkout'}."
  end

  desc "Build gem package (runs the quality gate first)"
  depends_on :quality
  def build
    gemspec = Dir.glob("*.gemspec").first
    abort "No gemspec found in #{Dir.pwd}." unless gemspec
    version = gem_version
    abort "Cannot determine #{@@gem_name}'s version from #{gemspec} or lib/**/version.rb." if version == "?.?.?"

    FileUtils.mkdir_p("pkg")
    sh "gem build #{gemspec} --output pkg/#{@@gem_name}-#{version}.gem"
  end

  desc "Build and install gem locally"
  depends_on :build
  def install
    sh "gem install pkg/#{@@gem_name}-#{gem_version}.gem --local"
  end

  # Hidden (no desc): release runs it first, so a release from any branch but
  # @@release_branch stops before the quality gate and the build.
  def main_branch
    error = release_branch_error(current_branch, @@release_branch)
    abort error if error
  end

  desc "release", "Release gem to RubyGems from the release branch (builds behind the quality gate first)"
  option :yes, aliases: "-y", type: :boolean, default: false, desc: "Skip confirmation prompt"
  depends_on :main_branch, :build
  def release
    version = gem_version
    abort "Cannot determine #{@@gem_name}'s version from its gemspec or lib/**/version.rb — refusing to release." if version.to_s.empty? || version == "?.?.?"

    unless options[:yes]
      print "Release #{@@gem_name} v#{version} to RubyGems? [y/N] "
      $stdout.flush
      return puts "Aborted." unless $stdin.gets.to_s.strip.downcase == "y"
    end

    # Untracked files never reach the gem (git ls-files-based gemspecs), so
    # only modifications to tracked files block a release.
    abort "Working directory is not clean — commit or stash changes first." unless `git status --porcelain --untracked-files=no`.strip.empty?

    tag = "v#{version}"
    abort "Tag #{tag} already exists." unless `git tag -l "#{tag}"`.strip.empty?

    sh "git tag #{tag}"
    sh "git push"
    sh "git push origin #{tag}"
    sh "gem push pkg/#{@@gem_name}-#{version}.gem"
    puts "\nReleased #{@@gem_name} v#{version}."
  end
end
