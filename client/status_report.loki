# frozen_string_literal: true
# dev/client/status_report.loki — end-of-week client status reporting.
# Import it with `import_up "dev/client/*.loki"`.
#
# `daily_summary` collects today's activity from every configured source
# (each a `*_collect` task, discovered the same way quality.loki discovers
# `*_check` tasks) into notes/_status/<date>.md under RR. `weekly_report`
# reads the week's daily files and asks headless Claude Code (`claude -p`)
# to turn them into a client-facing Markdown report.
#
# `shell_hourly` summarizes the clock hour that just ended (again with
# `claude -p`) into notes/_status/shell/<date>/<HH>00-<HH+1>00.md, and
# `daily_summary` embeds those summaries in place of the raw command list
# when the day has any. It is meant to be scheduled, e.g. for a 09:00-17:00
# day, in the project's .loki:
#   schedule :shell_hourly, at: %w[10:00 11:00 12:00 13:00 14:00 15:00 16:00 17:00], on: :weekdays
# A specific hour: STATUS_DATE=2026-09-29 STATUS_HOUR=14 asgard shell_hourly
#
# git_collect and github_collect cover RR and every repo listed in
# STATUS_REPO_DIRS (":"-separated; relative paths resolve against RR).
#
# A day other than today: STATUS_DATE=2026-09-22 asgard daily_summary
# (collector tasks can't take arguments as asgard dependencies, so the date
# travels via env var instead of a --date option).
# A week other than the current one (any day in that week; it snaps back
# to Monday): STATUS_WEEK_OF=2026-09-22 asgard weekly_report

# A scheduled run (launchd) has no LANG, so Ruby defaults to US-ASCII and
# shell history or `claude` output can't be mixed with the UTF-8 literals
# below.
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

require "date"
require "fileutils"
require "json"
require "net/http"
require "open3"

class Tasks
  COLLECTOR_LABEL_OVERRIDES = { "github" => "GitHub" }.freeze

  no_commands do
    def status_repo_root = ENV.fetch("RR", Dir.pwd)

    # The git repos git_collect and github_collect cover: the repo root,
    # then each directory in STATUS_REPO_DIRS (separated by ":", relative
    # ones resolved against the root), for a project whose work is spread
    # over several clones. Directories that are not a git work tree are
    # dropped, and one reached by two paths is listed once.
    def status_repo_dirs(root = status_repo_root, extra = ENV.fetch("STATUS_REPO_DIRS", ""))
      [root, *extra.split(File::PATH_SEPARATOR).reject(&:empty?).map { File.expand_path(it, root) }]
        .select { File.exist?(File.join(it, ".git")) }
        .uniq { File.realpath(it) }
    end

    # Pure: a section heading for each repo path: its basename, else
    # parent/basename where basenames repeat, else the full path, so no two
    # repos share a heading (and one can't overwrite the other's commits).
    def status_repo_labels(paths)
      labels = paths.to_h { [it, File.basename(it)] }
      [->(path) { File.join(File.basename(File.dirname(path)), File.basename(path)) }, :itself.to_proc].each do |longer|
        repeated = labels.values.tally.select { |_, n| n > 1 }.keys
        labels.each_key { |path| labels[path] = longer.(path) if repeated.include?(labels[path]) }
      end
      labels
    end

    # Pure: per-repo Markdown bodies as one section. A single repo's body
    # stands alone; several are each headed by their repo's name.
    def status_repo_sections(bodies)
      return bodies.values.first if bodies.size == 1

      bodies.map { |name, body| "**#{name}**\n#{body}" }.join("\n\n")
    end

    def status_target_date = status_env_date("STATUS_DATE", "daily_summary")

    # Date from env var `var`, or today when unset. A value Date.parse
    # can't read aborts with one line instead of a backtrace; SystemExit
    # isn't a StandardError, so `collect` can't turn it into a SKIP.
    def status_env_date(var, task)
      value = ENV.fetch(var, nil)
      return Date.today if value.nil?

      Date.parse(value)
    rescue ArgumentError # Date::Error, or the date gem's over-128-chars limit
      abort "#{task}: #{var} must be a date like 2026-09-22 (got #{value.inspect})"
    end

    def status_dir = File.join(status_repo_root, "notes", "_status")

    # Monday of the week containing date; Sunday belongs to the week before.
    def status_week_start(date) = date - (date.cwday - 1)

    def status_day_bounds(date = status_target_date)
      [date.strftime("%Y-%m-%d 00:00:00"), date.strftime("%Y-%m-%d 23:59:59")]
    end

    # [stdout, succeeded?] — `ok` is falsy on any failure, so most callers
    # only branch on it. It is nil, not false, when the binary isn't
    # installed, so a caller can tell "missing" from "ran and failed".
    # The command's stderr is discarded: each caller's SKIP line already
    # says what failed.
    def safe_capture2(*argv, **opts)
      out, status = Open3.capture2(*argv, err: File::NULL, **opts)
      [out, status.success?]
    rescue Errno::ENOENT
      ["", nil]
    rescue StandardError
      ["", false]
    end

    # Runs a *_collect body, converting any exception into a SKIP instead
    # of letting it blow up the whole daily_summary dependency graph — a
    # flaky Jira request or a missing CLI must never abort the other
    # collectors.
    def collect(name)
      yield
    rescue StandardError => e
      puts "#{name}: SKIP (#{e.class}: #{e.message})"
      nil
    end

    def skip(name, reason)
      puts "#{name}: SKIP (#{reason})"
      nil
    end

    # Bash `history | fgrep DATE`, run in a fresh bash that loads
    # ~/.bash_history with a timestamp format. Reading the file directly
    # does not work: bash stores each timestamp as a "#<epoch>" line above
    # its command, never as a date on the command's own line. Entries saved
    # without a timestamp are all stamped with the load time, so the load
    # window is bracketed with MARK lines and stripped by
    # shell_history_commands.
    def shell_history_raw(date)
      script = <<~'BASH'
        HISTFILE="$HOME/.bash_history"
        HISTTIMEFORMAT="%F %T "
        echo "MARK $(date '+%F %T')"
        history -r
        echo "MARK $(date '+%F %T')"
        history | fgrep "$1" || true
      BASH
      safe_capture2("bash", "-c", script, "bash", date.to_s)
    end

    SHELL_SECRET_PATTERN = /(_KEY|_TOKEN|_SECRET|PASSWORD)\s*=/i
    SHELL_NOISY_COMMANDS = %w[cd ls ll clear pwd history].freeze

    # Pure: shell_history_raw output as "- `HH:MM:SS` `command`" lines for
    # +date+, without the load-window (untimestamped) entries, secret-looking
    # lines and bare navigation commands. +hour+ (0-23) keeps only commands
    # typed during that clock hour.
    def shell_history_commands(raw, date, hour: nil)
      raw = raw.dup.force_encoding(Encoding::UTF_8).scrub
      marks = raw.scan(/^MARK (\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})$/).flatten
      load_from, load_to = marks.first, marks.last

      raw.lines(chomp: true).filter_map do |l|
        m = l.match(/\A\s*\d+\s+(#{Regexp.escape(date.to_s)} \d{2}:\d{2}:\d{2})\s+(.*)\z/) or next
        stamp, cmd = m[1], m[2].strip
        next if cmd.empty? || SHELL_NOISY_COMMANDS.include?(cmd) || SHELL_SECRET_PATTERN.match?(cmd)
        next if load_from && stamp >= load_from && stamp <= load_to
        next if hour && stamp[11, 2].to_i != hour

        "- `#{stamp[11..]}` `#{cmd}`"
      end
    end

    # [date, hour] of the clock hour shell_hourly summarizes. With neither
    # variable set it is the hour that ended before +now+, on the day that
    # hour belongs to (so a run just after midnight covers 23:00 of the day
    # before). STATUS_DATE and STATUS_HOUR each override their half.
    def shell_summary_slot(now = Time.now, date: ENV.fetch("STATUS_DATE", nil), hour: ENV.fetch("STATUS_HOUR", nil))
      previous = now - 3600
      day = date ? status_env_date("STATUS_DATE", "shell_hourly") : previous.to_date
      return [day, previous.hour] if hour.nil?

      parsed = Integer(hour, 10, exception: false)
      abort "shell_hourly: STATUS_HOUR must be an hour from 0 to 23 (got #{hour.inspect})" unless (0..23).cover?(parsed)
      [day, parsed]
    end

    # Pure: "0900-1000" for the hour starting at 9 ("09:00-10:00" with a ":" separator).
    def shell_hour_label(hour, separator = "")
      format("%<a>02d#{separator}00-%<b>02d#{separator}00", a: hour, b: hour + 1)
    end

    def shell_summary_path(date, hour)
      File.join(status_dir, "shell", date.to_s, "#{shell_hour_label(hour)}.md")
    end

    # Pure: the prompt that turns one hour of commands into a summary.
    def shell_summary_prompt(date, hour, commands)
      <<~PROMPT
        Summarize the shell commands below, typed #{shell_hour_label(hour, ":").sub("-", " to ")}
        on #{date}, in 1-3 plain sentences about what was being worked on. Group related
        commands, ignore trivial navigation (cd, ls, clear), name projects or tickets you
        can infer, and quote no secrets. Output only the summary text.

        #{commands.join("\n")}
      PROMPT
    end

    # stdout of headless Claude Code (`claude -p`) for +prompt+; aborts,
    # naming +task+, when claude is missing or fails. ANTHROPIC_API_KEY is
    # dropped for this child process only: `claude -p` prefers it over the
    # CLI's own OAuth login, and a stray/expired key elsewhere in the shell
    # environment must not break the task's auth.
    def claude_print(prompt, task)
      stdout, status = begin
        Open3.capture2({ "ANTHROPIC_API_KEY" => nil }, "claude", "-p", prompt)
      rescue Errno::ENOENT
        abort "#{task}: `claude` not found on PATH. Install the Claude CLI (https://docs.claude.com/claude-code) and run `claude /login` once."
      end
      abort "#{task}: claude -p failed (exit #{status.exitstatus}) — is `claude` logged in? Try `claude` interactively once, or `claude /login`." unless status.success?

      stdout
    end

    # First human-typed message in a Claude Code session transcript,
    # trimmed — a rough "what we worked on" label. Deliberately skips
    # system-reminder/tool-wrapper content that rides along inside a user
    # turn rather than treating it as something the human said.
    def claude_session_snippet(path)
      File.foreach(path) do |line|
        entry = begin
          JSON.parse(line)
        rescue JSON::ParserError
          next
        end
        next unless entry["type"] == "user"

        content = entry.dig("message", "content")
        text = case content
               when String then content
               when Array  then content.find { |c| c["type"] == "text" }&.fetch("text", nil)
               end
        next unless text

        text = text.sub(%r{\A<system-reminder>.*?</system-reminder>\s*}m, "").strip
        next if text.empty?
        # Anything still starting with "<" is another synthetic wrapper
        # (<local-command-caveat>, tool-result stand-ins, etc.), not
        # something the human actually typed — keep scanning.
        next if text.start_with?("<")

        return text.length > 150 ? "#{text[0, 150].sub(/\s+\S*\z/, "")}…" : text
      end
      nil
    end
  end

  # ---- collectors -----------------------------------------------------
  # Each returns nil (nothing to report for the day — puts why) or a
  # Markdown body with no top-level header; daily_summary supplies
  # "## <Source>" itself.

  desc "Collect the target date's _notes.txt journal entries"
  def notes_collect
    collect("notes") do
      path = File.join(status_repo_root, "_notes.txt")
      next skip("notes", "no _notes.txt at #{path}") unless File.exist?(path)

      wanted = status_target_date.to_s
      entries = {}
      current = nil
      File.foreach(path) do |line|
        if (m = line.match(/\A--- (\d{4}-\d{2}-\d{2}) \d{2}:\d{2}:\d{2} [+-]\d{4}\s*\z/))
          current = m[1]
          entries[current] ||= +""
        elsif current
          entries[current] << line
        end
      end

      body = entries[wanted]&.strip
      next skip("notes", "no entries for #{wanted}") if body.nil? || body.empty?

      puts "notes: found the journal entry for #{wanted}"
      body.lines.map { |l| "> #{l}" }.join
    end
  end

  desc "Collect the target date's git commits authored by you, on any branch, in every status repo"
  def git_collect
    collect("git") do
      since, until_ts = status_day_bounds
      dirs   = status_repo_dirs
      labels = status_repo_labels(dirs.map { File.realpath(it) })
      bodies = dirs.each_with_object({}) do |dir, found|
        email, ok = safe_capture2("git", "-C", dir, "config", "user.email")
        email = email.strip
        next unless ok && !email.empty?

        # --all: work on a branch that is not checked out still counts.
        log, ok = safe_capture2("git", "-C", dir, "log", "--all", "--author=#{email}",
                                 "--since=#{since}", "--until=#{until_ts}",
                                 "--pretty=format:- %h %s")
        found[labels.fetch(File.realpath(dir))] = log.strip if ok && !log.strip.empty?
      end
      next skip("git", "no commits for #{status_target_date}") if bodies.empty?

      puts "git: #{bodies.values.sum { it.lines.size }} commit(s) in #{bodies.size} repo(s)"
      status_repo_sections(bodies)
    end
  end

  desc "Collect the target date's GitHub PR/issue activity you were involved in, in every status repo"
  def github_collect
    collect("github") do
      repos = status_repo_dirs.filter_map do |dir|
        nwo, ok = safe_capture2("gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner", chdir: dir)
        nwo.strip if ok && !nwo.strip.empty?
      end.uniq
      next skip("github", "gh not available or not a GitHub repo") if repos.empty?

      date = status_target_date.to_s
      bodies = repos.each_with_object({}) do |nwo, found|
        items = { "prs" => "PR", "issues" => "Issue" }.flat_map do |kind, label|
          out, ok = safe_capture2("gh", "search", kind, "--repo", nwo, "--involves=@me",
                                   "--updated=#{date}", "--json", "number,title,state", "--limit", "50")
          next [] unless ok

          parsed = begin
            JSON.parse(out)
          rescue JSON::ParserError
            []
          end
          parsed.map { |item| "- #{label} ##{item["number"]}: #{item["title"]} (#{item["state"]})" }
        end
        found[nwo] = items.join("\n") unless items.empty?
      end
      next skip("github", "no PR/issue activity for #{date}") if bodies.empty?

      puts "github: #{bodies.values.sum { it.lines.size }} item(s) in #{bodies.size} repo(s)"
      status_repo_sections(bodies)
    end
  end

  desc "Collect the target date's Jira activity in the project"
  def jira_collect
    collect("jira") do
      site, project, email, token = ENV.values_at("JIRA_SITE", "JIRA_PROJECT", "JIRA_USER_EMAIL", "JIRA_API_KEY")
      if [site, project, email, token].any?(&:nil?)
        next skip("jira", "JIRA_SITE/PROJECT/USER_EMAIL/API_KEY not fully configured")
      end

      since, until_ts = status_day_bounds
      jql = %(project = #{project} AND updated >= "#{since[0, 16]}" AND updated <= "#{until_ts[0, 16]}" ORDER BY updated DESC)

      # Atlassian deprecated /rest/api/3/search (returns HTTP 410) in favor
      # of /rest/api/3/search/jql — see
      # https://developer.atlassian.com/changelog/#CHANGE-2046
      uri = URI("#{site}/rest/api/3/search/jql")
      uri.query = URI.encode_www_form(jql: jql, fields: "summary,status,assignee")

      req = Net::HTTP::Get.new(uri)
      req["Authorization"] = "Basic #{["#{email}:#{token}"].pack("m0")}"
      req["Accept"] = "application/json"
      response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(req) }

      next skip("jira", "HTTP #{response.code}") unless response.is_a?(Net::HTTPSuccess)

      issues = JSON.parse(response.body)["issues"] || []
      next skip("jira", "no #{project} activity for #{status_target_date}") if issues.empty?

      puts "jira: #{issues.size} issue(s)"
      issues.map do |issue|
        fields = issue["fields"]
        assignee = fields.dig("assignee", "displayName") || "unassigned"
        "- #{issue["key"]}: #{fields["summary"]} (#{fields.dig("status", "name")}, #{assignee})"
      end.join("\n")
    end
  end

  desc "Collect the target date's Claude Code session activity for this project"
  def claude_sessions_collect
    collect("claude_sessions") do
      dir = File.join(Dir.home, ".claude", "projects", status_repo_root.gsub(%r{[/_]}, "-"))
      next skip("claude_sessions", "no session directory at #{dir}") unless Dir.exist?(dir)

      date = status_target_date
      files = Dir.glob(File.join(dir, "*.jsonl")).select { |f| File.mtime(f).to_date == date }
      next skip("claude_sessions", "no sessions modified on #{date}") if files.empty?

      snippets = files.filter_map { |f| claude_session_snippet(f) }
      next skip("claude_sessions", "sessions found but no readable user messages") if snippets.empty?

      puts "claude_sessions: #{snippets.size} session(s)"
      snippets.map { |s| "- #{s}" }.join("\n")
    end
  end

  desc "Collect the target date's shell commands (hourly summaries if present, else bash history)"
  def shell_history_collect
    collect("shell_history") do
      date = status_target_date
      hourly = Dir.glob(File.join(status_dir, "shell", date.to_s, "*.md")).sort
      if hourly.any?
        puts "shell_history: #{hourly.size} hourly summary(ies)"
        next hourly.map { |f| File.read(f).strip }.join("\n\n")
      end

      out, ok = shell_history_raw(date)
      next skip("shell_history", "could not run bash history") unless ok

      lines = shell_history_commands(out, date)
      next skip("shell_history", "no commands for #{date} in ~/.bash_history") if lines.empty?

      puts "shell_history: #{lines.size} command(s) (no hourly summaries)"
      lines.join("\n")
    end
  end

  desc "Collect the target date's calendar events"
  def calendar_collect
    collect("calendar") do
      date = status_target_date
      tz = Time.now.strftime("%z")
      from = "eventsFrom:#{date} 00:00:00 #{tz}"
      to = "to:#{date} 23:59:59 #{tz}"

      out, ok = safe_capture2("icalBuddy", "-nc", "-eep", "location,notes,url",
                               "-po", "title,datetime,attendees", from, to)
      next skip("calendar", "icalBuddy not available (brew install ical-buddy)") if ok.nil?
      next skip("calendar", "icalBuddy failed (check the terminal's Calendar access)") unless ok
      next skip("calendar", "no events for #{date}") if out.strip.empty?

      puts "calendar: events found"
      out.strip
    end
  end

  # ---- orchestration ----------------------------------------------------

  # Runs ahead of the collectors so a bad STATUS_DATE stops daily_summary
  # with one line before any of them start. Named *_guard, not *_check:
  # quality.loki sweeps every *_check task into `asgard quality`.
  desc "Abort unless STATUS_DATE (if set) is a readable date"
  def status_date_guard = status_target_date

  desc "Collect the target date's activity from every configured source into notes/_status/<date>.md"
  depends_on -> { [:status_date_guard, all_commands.keys.grep(/_collect\z/).sort.map(&:to_sym)] }
  def daily_summary
    date = status_target_date
    collect_tasks = self.class._deps.fetch(:daily_summary, []).flatten.map(&:to_s).grep(/_collect\z/)

    sections = collect_tasks.filter_map do |name|
      body = dep_result(name)
      next if body.nil? || body.to_s.strip.empty?

      base = name.sub(/_collect\z/, "")
      label = COLLECTOR_LABEL_OVERRIDES[base] || base.split("_").map(&:capitalize).join(" ")
      "## #{label}\n\n#{body}"
    end

    FileUtils.mkdir_p(status_dir)
    out_path = File.join(status_dir, "#{date}.md")
    body = sections.empty? ? "_No activity captured for #{date}._" : sections.join("\n\n")
    File.write(out_path, "# #{date}\n\n#{body}\n")
    puts "Wrote #{out_path} (#{sections.size}/#{collect_tasks.size} source(s) had activity)"
  end

  desc "Summarize the previous hour's shell commands into notes/_status/shell/<date>/ via Claude"
  def shell_hourly
    date, hour = shell_summary_slot
    out, ok = shell_history_raw(date)
    abort "shell_hourly: could not run bash history" unless ok

    commands = shell_history_commands(out, date, hour: hour)
    summary = commands.empty? ? "_No shell activity._" : claude_print(shell_summary_prompt(date, hour, commands), "shell_hourly").strip

    path = shell_summary_path(date, hour)
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, "### #{shell_hour_label(hour, ":")}\n\n#{summary}\n")
    puts "Wrote #{path} (#{commands.size} command(s))"
  end

  desc "Assemble the week's daily summaries into a client status report via Claude"
  def weekly_report
    monday = status_week_start(status_env_date("STATUS_WEEK_OF", "weekly_report"))
    week_files = (0..4).map { |i| File.join(status_dir, "#{monday + i}.md") }.select { |f| File.exist?(f) }

    abort "weekly_report: no daily summaries found for the week of #{monday}. Run daily_summary each day first." if week_files.empty?

    raw = week_files.map { |f| File.read(f) }.join("\n\n---\n\n")

    prompt = <<~PROMPT
      You are drafting a Friday end-of-week status report for a consulting client, from a
      contractor's raw daily activity logs below (one per weekday, collected automatically
      from git, GitHub, Jira, personal notes, Claude Code sessions, shell history, and
      calendar). Turn this into a finished, client-facing Markdown report:

      - Short, plain-spoken lead-in paragraph, not corporate-sounding.
      - A bulleted body grouped by theme (not by source) — e.g. access/setup, code review,
        Jira/spec work, tooling/docs, meetings — dropping anything that's just noise
        (routine commands, empty sections).
      - Call out any deadlines, blockers, or priority decisions explicitly.
      - Sign off simply, first name only.

      Raw week:

      #{raw}
    PROMPT

    stdout = claude_print(prompt, "weekly_report")

    out_path = File.join(status_dir, "week-of-#{monday}.md")
    File.write(out_path, stdout)
    puts "Wrote #{out_path} — review before sending."
  end
end
