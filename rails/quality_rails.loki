# frozen_string_literal: true
# MadBomber-level Rails-specific quality gate tasks. Universal across all
# projects. Import from a project-level loki (e.g.
# `import_up "dev/rails/*.loki" if ENV["RAILS_ROOT"]`), mirroring
# asgard's own quality_rails.loki. Gated on RAILS_ROOT rather than
# `defined?(Rails)`: asgard runs as a separate process outside the app it's
# checking, so the app's Rails constant is never loaded into asgard's own
# process. RAILS_ROOT is set in a Rails repo's own .envrc
# (`export RAILS_ROOT=$RR`, after RR is defined) as the signal instead.
#
# `quality` (in quality.loki) discovers every *_check task at run time by
# introspecting Tasks.all_commands, rather than a fixed depends_on list — so
# any *_check task defined here is automatically picked up by `asgard
# quality` too, with no need to redeclare or extend anything. Each gate
# reports through run_gate / skip_gate (quality.loki), which settle the
# gate's row on the live quality board.
#
# Note on rubocop-rails: it's a RuboCop plugin, not a standalone CLI, so it
# has no *_check task of its own here. Add the gem to the app's Gemfile and
# `require: rubocop-rails` in its .rubocop.yml — the existing rubocop_check
# (quality.loki) picks up the added Rails cops automatically.

# bundled_gem?, run_gate and skip_gate live in ../quality.loki. Importing it here lets a project load
# the Rails gates on their own. The guard, not just import's own
# already-loaded check, keeps it to one load when dev/ is reached through
# a symlink: import resolves this file's relative path to the real one, a
# different string from the symlinked path import_up recorded.
import "../quality.loki" unless Tasks.method_defined?(:bundled_gem?)

class Tasks
  desc "Check for Rails security vulnerabilities with Brakeman"
  def brakeman_check
    return skip_gate(:brakeman, "Brakeman", not_bundled_hint("brakeman")) unless bundled_gem?("brakeman")

    run_gate(:brakeman, "Brakeman", "bundle exec brakeman -q", summary: /warnings? found/i)
  end

  desc "Check for Rails anti-patterns with RailsBestPractices"
  def rails_best_practices_check
    unless bundled_gem?("rails_best_practices")
      return skip_gate(:rails_best_practices, "RailsBestPractices", not_bundled_hint("rails_best_practices"))
    end

    run_gate(:rails_best_practices, "RailsBestPractices",
             "bundle exec rails_best_practices --silent --without-color .", summary: /warning/i)
  end

  # Advisory: a finding is a schema suggestion to weigh (silence the tool's
  # false positives in the app's .active_record_doctor.rb), not a failure of
  # the change under review, so findings report :warn. Named ard_check, not
  # active_record_doctor_check, to keep the board's rows short; its output
  # goes to ard_output.txt.
  desc "Check for database schema issues with ActiveRecordDoctor (advisory)"
  def ard_check
    unless bundled_gem?("active_record_doctor")
      return skip_gate(:ard, "ActiveRecordDoctor", not_bundled_hint("active_record_doctor"))
    end

    run_gate(:ard, "ActiveRecordDoctor", "bundle exec rake active_record_doctor", on_fail: :warn,
             summary: lambda { |output, result|
               result == :pass ? "no issues found" : "#{output.lines.count { |l| l.strip != "" }} issue line(s) found"
             })
  end
end
